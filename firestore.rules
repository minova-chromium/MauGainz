rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(userId) { return signedIn() && request.auth.uid == userId; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'vandemoorteletamino@gmail.com';
    }
    function coachingPath(coachId, clientId) {
      return /databases/$(database)/documents/coachingRelationships/$(coachId + '_' + clientId);
    }
    function isAcceptedCoach(clientId) {
      return signedIn()
        && exists(coachingPath(request.auth.uid, clientId))
        && get(coachingPath(request.auth.uid, clientId)).data.coachUid == request.auth.uid
        && get(coachingPath(request.auth.uid, clientId)).data.clientUid == clientId
        && get(coachingPath(request.auth.uid, clientId)).data.status == 'accepted';
    }
    function isManagingCoach(clientId) {
      return isAcceptedCoach(clientId)
        && get(coachingPath(request.auth.uid, clientId)).data.mode == 'managed';
    }

    match /users/{userId}/data/{documentId} {
      allow read: if owns(userId) || isAcceptedCoach(userId);
      allow write: if owns(userId) || isManagingCoach(userId);
    }

    match /publicProfiles/{userId} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update: if owns(userId) && request.resource.data.uid == userId;
      allow delete: if owns(userId) && resource.data.uid == userId;
    }

    // Private account metadata for the owner and the MauGainZ administrator.
    // Recipe, diary, weight and meal-plan contents remain in /users and cannot
    // be read by the administrator.
    match /accountProfiles/{userId} {
      allow get: if owns(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if owns(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'friendCode', 'createdAt', 'lastSeen',
          'platform', 'appVersion', 'recipeCount', 'diaryEntryCount',
          'savedIngredientCount'
        ]);
      allow delete: if false;
    }

    match /friendCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /friendRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.status == 'accepted';
      allow delete: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /recipeShares/{shareId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.status == 'accepted';
      allow delete: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /coachingRelationships/{relationshipId} {
      allow create: if signedIn()
        && request.resource.data.coachUid == request.auth.uid
        && request.resource.data.clientUid != request.auth.uid
        && relationshipId == request.auth.uid + '_' + request.resource.data.clientUid
        && request.resource.data.status == 'pending'
        && request.resource.data.mode in ['shared', 'managed']
        && request.resource.data.keys().hasOnly([
          'coachUid', 'coachName', 'coachCode', 'clientUid', 'clientName',
          'clientCode', 'mode', 'status', 'createdAt'
        ]);
      allow read: if signedIn()
        && (resource.data.coachUid == request.auth.uid || resource.data.clientUid == request.auth.uid);
      allow update: if signedIn()
        && request.resource.data.coachUid == resource.data.coachUid
        && request.resource.data.clientUid == resource.data.clientUid
        && request.resource.data.coachCode == resource.data.coachCode
        && request.resource.data.clientCode == resource.data.clientCode
        && request.resource.data.keys().hasOnly([
          'coachUid', 'coachName', 'coachCode', 'clientUid', 'clientName',
          'clientCode', 'mode', 'status', 'createdAt', 'acceptedAt', 'revokedAt'
        ])
        && (
          (resource.data.clientUid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.mode == resource.data.mode
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.status in ['accepted', 'rejected'])
          || ((resource.data.clientUid == request.auth.uid || resource.data.coachUid == request.auth.uid)
            && resource.data.status in ['pending', 'accepted']
            && request.resource.data.mode == resource.data.mode
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.status == 'revoked')
          || (resource.data.coachUid == request.auth.uid
            && resource.data.status in ['rejected', 'revoked']
            && request.resource.data.status == 'pending'
            && request.resource.data.mode in ['shared', 'managed'])
        );
      allow delete: if false;
    }
  }
}
