rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(userId) { return signedIn() && request.auth.uid == userId; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'vandemoorteletamino@gmail.com';
    }

    match /users/{userId}/data/{documentId} {
      allow read, write: if owns(userId);
    }

    match /publicProfiles/{userId} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update: if owns(userId) && request.resource.data.uid == userId;
      allow delete: if owns(userId) && resource.data.uid == userId;
    }

    // Private account metadata for the owner and the MauGainZ administrator.
    // Recipe, diary, weight and meal-plan contents remain in /users and cannot
    // be read by the administrator.
    match /accountProfiles/{userId} {
      allow get: if owns(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if owns(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'friendCode', 'createdAt', 'lastSeen',
          'platform', 'appVersion', 'recipeCount', 'diaryEntryCount',
          'savedIngredientCount'
        ]);
      allow delete: if false;
    }

    match /friendCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /friendRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.status == 'accepted';
      allow delete: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /recipeShares/{shareId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.status == 'accepted';
      allow delete: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }
  }
}
