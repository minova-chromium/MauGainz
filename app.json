{
  "expo": {
    "name": "MauGainZ",
    "slug": "maugains",
    "version": "2.5.2",
    "orientation": "default",
    "icon": "./assets/branding/maugainz-v3-mark.png",
    "splash": {
      "image": "./assets/branding/maugainz-v3-lockup.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0C09"
    },
    "userInterfaceStyle": "dark",
    "androidStatusBar": {
      "backgroundColor": "#0B0C09",
      "barStyle": "light-content"
    },
    "android": {
      "package": "com.maugains.cookbook",
      "versionCode": 22,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/maugainz-v3-mark.png",
        "backgroundColor": "#0B0C09"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-font",
      "expo-image-picker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MauGainZ to scan food barcodes",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "rn-mlkit-ocr",
        {
          "ocrModels": ["latin"],
          "ocrUseBundled": true
        }
      ]
    ]
  }
}
